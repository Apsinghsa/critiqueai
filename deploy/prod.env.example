# Copied to the VPS as deploy/prod.env and consumed by the deploy job.
# Set these as GitHub Actions secrets (repo: Apsinghsa/critiqueai).

# Gemini API key (note: the app reads os.getenv('GEN_API2'))
GEN_API2=<your-gemini-key>

# Supabase (managed DB) — required or the app raises RuntimeError at startup
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Comma-separated allowed origins for CORS
CORS_ORIGINS=https://your-critiqueai.vercel.app